PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://lucky:lucky@ac-qfnhnpm-shard-00-00.zmctpcr.mongodb.net:27017,ac-qfnhnpm-shard-00-01.zmctpcr.mongodb.net:27017,ac-qfnhnpm-shard-00-02.zmctpcr.mongodb.net:27017/fridgetotable-db?ssl=true&replicaSet=atlas-bznx4x-shard-0&authSource=admin&appName=Cluster0


# Frontend origin(s) allowed to send credentialed (cookie) requests.
# Comma-separate for multiple, e.g. http://localhost:5173,https://yourapp.com
CLIENT_ORIGIN=http://localhost:5173

# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret

GEMINI_API_KEY=your_gemini_api_key_here
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
